// Diagrama LÓGICO — renderizar: dot -Tpng diagrama_logico.dot -o diagrama_logico.png
// PK = chave primária, FK = chave estrangeira, UN = UNIQUE, opc = aceita NULL. Seta: FK -> PK referenciada.
digraph L { rankdir=LR; nodesep=0.35; ranksep=1.1; fontname="Helvetica";
 node [shape=plain, fontname="Helvetica", fontsize=10]; edge [arrowhead=normal, color="#555555", fontsize=9];
 marca [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#eeeeee"><b>marca (fornecida)</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_marca</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">nome  [UN]</td></tr></table>>];
 modelo [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#eeeeee"><b>modelo (fornecida)</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_modelo</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">nome</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">carroceria</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">cod_marca</td></tr></table>>];
 cliente [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>cliente</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_cliente</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">nome</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">cpf  [UN]</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">email  [opc]</td></tr></table>>];
 telefone_cliente [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>telefone_cliente</b></td></tr><hr/><tr><td align="left" width="38"><b>PK,FK</b></td><td align="left">cod_cliente</td></tr><tr><td align="left" width="38"><b>PK</b></td><td align="left">telefone</td></tr></table>>];
 veiculo [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>veiculo</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">placa</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">cod_modelo</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">cod_cliente  [opc]</td></tr></table>>];
 funcionario [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>funcionario</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_funcionario</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">nome</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">cargo</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">matricula  [UN]</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">ativo</td></tr></table>>];
 tarifa [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>tarifa</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_tarifa</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">valor_hora</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">vigencia_inicio  [UN]</td></tr></table>>];
 loja_conveniada [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>loja_conveniada</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_loja</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">nome</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">cnpj  [UN]</td></tr></table>>];
 estacionamento [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>estacionamento</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_estacionamento</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">nome</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">logradouro</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">numero</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">bairro</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">cidade</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">uf</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">cep</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">capacidade_maxima</td></tr></table>>];
 estadia [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>estadia</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_estadia</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">placa</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">cod_funcionario</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">cod_loja  [opc]</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">data_hora_entrada</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">data_hora_saida  [opc]</td></tr></table>>];
 pagamento [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>pagamento</b></td></tr><hr/><tr><td align="left" width="38"><b>PK,FK</b></td><td align="left">cod_estadia</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">cod_funcionario</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">forma</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">valor</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">data_hora_pagamento</td></tr></table>>];
 contrato [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>contrato</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_contrato</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">cod_cliente</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">placa</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">data_inicio</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">data_fim</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">valor_mensal</td></tr></table>>];
 mensalidade [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>mensalidade</b></td></tr><hr/><tr><td align="left" width="38"><b>PK,FK</b></td><td align="left">cod_contrato</td></tr><tr><td align="left" width="38"><b>PK</b></td><td align="left">competencia</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">data_vencimento</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">data_pagamento  [opc]</td></tr></table>>];
 tipo_ocorrencia [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>tipo_ocorrencia</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_tipo</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">nome  [UN]</td></tr></table>>];
 ocorrencia [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8f0fe"><b>ocorrencia</b></td></tr><hr/><tr><td align="left" width="38"><b>PK</b></td><td align="left">cod_ocorrencia</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">data_hora</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">cod_tipo</td></tr><tr><td align="left" width="38">&nbsp;</td><td align="left">descricao</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">cod_estadia</td></tr><tr><td align="left" width="38"><b>FK</b></td><td align="left">cod_funcionario</td></tr></table>>];
 modelo -> marca [label="cod_marca"];
 telefone_cliente -> cliente [label="cod_cliente"];
 veiculo -> modelo [label="cod_modelo"];
 veiculo -> cliente [label="cod_cliente"];
 estadia -> veiculo [label="placa"];
 estadia -> funcionario [label="cod_funcionario"];
 estadia -> loja_conveniada [label="cod_loja"];
 pagamento -> estadia [label="cod_estadia"];
 pagamento -> funcionario [label="cod_funcionario"];
 contrato -> cliente [label="cod_cliente"];
 contrato -> veiculo [label="placa"];
 mensalidade -> contrato [label="cod_contrato"];
 ocorrencia -> tipo_ocorrencia [label="cod_tipo"];
 ocorrencia -> estadia [label="cod_estadia"];
 ocorrencia -> funcionario [label="cod_funcionario"];
}
